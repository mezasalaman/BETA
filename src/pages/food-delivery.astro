---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Caso de Estudio | Food Delivery";
const description = "FoodDelivery — Caso de diseño de producto enfocado en onboarding, activación y conversión para una plataforma gastronómica.";
const ogImage = "https://mezasalaman.github.io/BETA/Media/GEOSATELITAL/img-portada-food.svg";
---
<BaseLayout title={title} description={description} ogImage={ogImage}>
<main class="pb-24">
        <!-- ================= HERO ================= -->
        <header class="mx-auto flex w-[90%] max-w-grid flex-col items-center px-0 pb-24 pt-10 text-center">
            <span class="mb-10 inline-block rounded-full border border-[#e0e5ec] bg-[#f3f5f8] px-[22px] py-2 text-[11px] font-bold tracking-[0.15em] text-royal">SENIOR PRODUCT DESIGNER STORYTELLING</span>

            <h1 class="title-massive mb-12 mt-8 font-extrabold uppercase text-[#0f172a]">
                FOODDELIVERY
                <span class="mt-4 block text-royal">Ecosistema Digital</span>
            </h1>

            <p class="mb-12 max-w-[700px] text-[17px] leading-[1.5] text-[#475569] md:text-[20px]">
                Rediseñé el onboarding de una plataforma de delivery gastronómico de extremo a extremo:
                menos fricción para activar la tienda y publicar productos. <strong class="font-semibold text-[#0f172a]">+32% de
                completitud y +18% de conversión.</strong>
            </p>

            <a href="/BETA/food-delivery-case/"
               class="group inline-flex items-center justify-center gap-3 rounded-full bg-royal px-10 py-4 text-[16px] font-bold text-[#ffffff] transition-all duration-300 hover:-translate-y-1 hover:bg-[#2a5ecf] hover:shadow-[0_10px_20px_rgba(59,113,254,0.3)] md:text-[18px]">
                Explorar caso de estudio
                <img loading="lazy" src="https://mezasalaman.github.io/BETA/Media/GEOSATELITAL/icon-arrow.svg" alt="flecha" class="h-5 w-auto brightness-0 invert transition-transform group-hover:translate-x-1" />
            </a>

            <div class="mx-auto mt-20 w-full max-w-grid overflow-hidden rounded-[32px] border border-[#e9edf2] bg-card shadow-showcase">
                <img loading="lazy" src="https://mezasalaman.github.io/BETA/Media/GEOSATELITAL/img-portada-food.svg" alt="FoodDelivery Interface" class="block w-full" />
            </div>
        </header>

        <!-- ================= PROBLEMA Y SOLUCIÓN ================= -->
        <section class="mx-auto w-[90%] max-w-grid py-20">
            <h2 class="mb-12 text-[24px] font-semibold">Problema y Solución</h2>
            <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-2">
                <!-- Problema -->
                <div class="flex flex-col rounded-[32px] border border-err/10 bg-card p-8 sm:p-11">
                    <div class="mb-8 flex items-center gap-3">
                        <img loading="lazy" src="https://mezasalaman.github.io/BETA/Media/GEOSATELITAL/info.svg" alt="alert" class="h-4 w-auto" />
                        <span class="text-[12px] font-bold uppercase tracking-[0.15em] text-err">EL PROBLEMA</span>
                    </div>
                    <h3 class="mb-6 text-[26px] font-semibold leading-[1.2] text-[#0f172a] sm:text-[32px]">Sobrecarga Cognitiva y <span class="font-bold text-err">Pérdida Operativa.</span></h3>
                    <p class="mb-auto text-[15px] font-light leading-[1.6] text-[#334155]">Fricción crítica en la comunicación entre administradores de Productos y Usuarios. Gestión ineficiente de Ventas resultando en <span class="font-bold text-err">pérdidas de Ventas del 22%.</span></p>
                    <div class="mt-9 flex gap-12 border-t border-[#e9edf2] pt-6">
                        <div class="flex flex-col">
                            <span class="text-[11px] font-semibold uppercase text-[#64748b]">IMPACTO NEGOCIO</span>
                            <span class="text-[20px] font-bold text-err">-22%</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-[11px] font-semibold uppercase text-[#64748b]">GRAVEDAD</span>
                            <span class="text-[20px] font-bold text-err">CRÍTICA</span>
                        </div>
                    </div>
                </div>

                <!-- Solución -->
                <div class="flex flex-col rounded-[32px] bg-gradient-to-br from-[#4A6FFF] to-[#2C2FFF] p-8 text-[#ffffff] sm:p-11">
                    <div class="mb-8 flex items-center gap-3">
                        <img loading="lazy" src="https://mezasalaman.github.io/BETA/Media/GEOSATELITAL/ia.svg" alt="stars" class="h-4 w-auto" />
                        <span class="text-[12px] font-bold uppercase tracking-[0.15em] text-[#dbe4ff]">LA SOLUCIÓN</span>
                    </div>
                    <h3 class="mb-6 text-[26px] font-semibold leading-[1.2] text-[#ffffff] sm:text-[32px]">Motor de Gestión Centralizado.</h3>
                    <p class="mb-auto text-[15px] font-light leading-[1.6] text-[#dbe4ff]">Implementación de una interfaz centralizada para la gestión de servicios y comunicación en tiempo real. Reducción de la carga cognitiva mediante flujos de trabajo optimizados.</p>
                    <div class="mt-9 flex items-center gap-3 self-start rounded-full bg-[rgba(255,255,255,0.22)] px-5 py-2.5">
                        <img loading="lazy" src="https://mezasalaman.github.io/BETA/Media/GEOSATELITAL/chek.svg" alt="check" class="h-5 w-auto" />
                        <span class="text-[14px]">Eficiencia Operativa Maximizada</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= CONTEXTO DE NEGOCIO (BENTO) ================= -->
        <section class="mx-auto w-[90%] max-w-grid py-20">
            <h2 class="mb-12 text-[24px] font-semibold">Contexto De Negocio</h2>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:grid-rows-[minmax(220px,auto)_minmax(220px,auto)_auto]">
                <!-- Main -->
                <div class="flex flex-col rounded-[32px] border border-[#edf0f4] bg-panel2 p-9 md:col-span-2 md:row-span-2">
                    <span class="mb-8 text-[11px] font-bold uppercase tracking-[0.15em] text-[#94a3b8]">CONTEXTO DE NEGOCIO</span>
                    <h3 class="mb-6 text-[26px] font-semibold leading-[1.2] text-[#0f172a] sm:text-[32px]">Redefiniendo el onboarding para operadores gastronómicos.</h3>
                    <p class="text-[16px] font-light leading-[1.6] text-[#64748b]">La plataforma anterior presentaba una curva de aprendizaje pronunciada, resultando en pérdidas significativas durante la primera semana de uso.</p>
                </div>
                <!-- Up -->
                <div class="flex flex-col items-center justify-center rounded-[32px] border border-[#edf0f4] bg-panel2 p-9 text-center">
                    <div class="mb-8 flex h-[50px] w-[50px] items-center justify-center rounded-full bg-electric/10">
                        <img loading="lazy" src="https://mezasalaman.github.io/BETA/Media/GEOSATELITAL/activacionsvg.svg" alt="rocket" class="h-5 w-auto" />
                    </div>
                    <h4 class="mb-4 text-[18px] font-semibold text-[#0f172a]">Aumentar activación</h4>
                    <p class="text-[13px] leading-[1.4] text-[#64748b]">Garantizar que el usuario complete su perfil en menos de 5 minutos.</p>
                </div>
                <!-- Down -->
                <div class="flex flex-col items-center justify-center rounded-[32px] border border-[#edf0f4] bg-panel2 p-9 text-center">
                    <div class="mb-8 flex h-[50px] w-[50px] items-center justify-center rounded-full bg-electric/10">
                        <img loading="lazy" src="https://mezasalaman.github.io/BETA/Media/GEOSATELITAL/reduccionsvg.svg" alt="down" class="h-5 w-auto" />
                    </div>
                    <h4 class="mb-4 text-[18px] font-semibold text-[#0f172a]">Reducir abandono</h4>
                    <p class="text-[13px] leading-[1.4] text-[#64748b]">Minimizar la fricción en el proceso de carga de productos y menús.</p>
                </div>
                <!-- Base -->
                <div class="flex flex-col items-center justify-between gap-6 rounded-[32px] border border-[#edf0f4] bg-panel2 px-9 py-6 text-center md:col-span-3 md:flex-row md:px-12 md:text-left">
                    <div class="md:max-w-[65%]">
                        <h4 class="mb-4 text-[22px] font-semibold text-[#0f172a]">Incrementar conversión</h4>
                        <p class="text-[13px] leading-[1.4] text-[#64748b]">Transformar usuarios de prueba en suscriptores recurrentes mediante valor inmediato.</p>
                    </div>
                    <div class="flex h-[90px] min-w-[90px] flex-col items-center justify-center rounded-full border border-[#e4e8ee] bg-[#f6f7f9] shadow-[inset_0_0_1.5rem_rgba(74,111,255,0.08)]">
                        <span class="text-[24px] font-bold text-electric">+21%</span>
                        <span class="text-[9px] font-semibold tracking-wider text-[#94a3b8]">TARGET</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= DECISIONES CLAVE ================= -->
        <section class="mx-auto w-[90%] max-w-grid py-20">
            <h2 class="mb-12 text-[24px] font-semibold">Decisiones clave</h2>
            <div class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-[35rem_1fr]">
                <!-- Labels -->
                <div class="flex flex-col gap-6 sm:flex-row lg:flex-col">
                    <div class="flex flex-1 flex-col justify-center rounded-[20px] border border-[#edf0f4] border-l-4 border-l-electric bg-gradient-to-r from-electric/5 to-transparent p-6">
                        <strong class="text-[16px] font-semibold">Activación temprana</strong>
                        <p class="mt-1 text-[13px] text-dim">Mostrar resultados antes de pedir datos complejos.</p>
                    </div>
                    <div class="flex flex-1 flex-col justify-center rounded-[20px] border border-[#edf0f4] bg-panel p-6">
                        <strong class="text-[16px] font-semibold">Rediseño onboarding</strong>
                        <p class="mt-1 text-[13px] text-dim">Estructura lineal y modular asistida por IA.</p>
                    </div>
                    <div class="flex flex-1 flex-col justify-center rounded-[20px] border border-[#edf0f4] bg-panel p-6">
                        <strong class="text-[16px] font-semibold">Priorización de tareas</strong>
                        <p class="mt-1 text-[13px] text-dim">Foco absoluto en la tarea crítica del momento.</p>
                    </div>
                </div>
                <!-- Metrics -->
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                    <div class="flex flex-col justify-center rounded-[24px] border border-[#edf0f4] bg-panel p-10 text-center">
                        <span class="mb-4 block text-[48px] font-bold text-electric">+32%</span>
                        <p class="text-[14px] text-dim">Completitud de Onboarding</p>
                    </div>
                    <div class="flex flex-col justify-center rounded-[24px] border border-[#edf0f4] bg-panel p-10 text-center">
                        <span class="mb-4 block text-[48px] font-bold text-electric">-27%</span>
                        <p class="text-[14px] text-dim">Tasa de Abandono</p>
                    </div>
                    <div class="flex flex-col justify-center rounded-[24px] border border-[#edf0f4] bg-panel p-10 text-center">
                        <span class="mb-4 block text-[48px] font-bold text-electric">+21%</span>
                        <p class="text-[14px] text-dim">Creación de Tiendas</p>
                    </div>
                    <div class="flex flex-col justify-center rounded-[24px] border border-[#edf0f4] bg-panel p-10 text-center">
                        <span class="mb-4 block text-[48px] font-bold text-electric">+18%</span>
                        <p class="text-[14px] text-dim">Conversión Final</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= MOCKUP FINAL ================= -->
        <section class="mx-auto flex w-[90%] max-w-grid flex-col items-center px-0 pb-12 pt-20 text-center">
            <div class="mb-12 max-w-[800px]">
                <span class="mb-8 block text-[11px] font-bold uppercase tracking-[0.15em] text-royal">THE SOLUTION</span>
                <h2 class="mb-8 text-[32px] font-bold leading-[1.1] text-[#0f172a] sm:text-[48px]">Menos fricción.<br />Más pedidos.</h2>
                <div class="flex flex-wrap justify-center gap-4">
                    <span class="rounded-full border border-[#e0e5ec] bg-[#f3f5f8] px-[22px] py-2 text-[12px] font-medium text-[#475569]">Onboarding en 7 pasos</span>
                    <span class="rounded-full border border-[#e0e5ec] bg-[#f3f5f8] px-[22px] py-2 text-[12px] font-medium text-[#475569]">Carga masiva con IA</span>
                    <span class="rounded-full border border-[#e0e5ec] bg-[#f3f5f8] px-[22px] py-2 text-[12px] font-medium text-[#475569]">Publicación instantánea</span>
                </div>
            </div>
            <img loading="lazy" src="https://mezasalaman.github.io/BETA/Media/GEOSATELITAL/img-mockup.svg" alt="FoodDelivery App" class="mx-auto block w-full max-w-grid rounded-[32px] drop-shadow-[0_40px_100px_rgba(0,0,0,0.3)]" />
        </section>
    </main>

    <!-- ================= NAV PROYECTOS ================= -->
    <section class="mx-auto mb-4 w-[90%] max-w-grid border-t border-[#e9edf2] pt-10">
        <div class="flex items-center justify-between gap-4">
            <a href="/BETA/#proyectos" class="group inline-flex items-center gap-3 text-[#64748b] transition-colors hover:text-[#0f172a]">
                <span class="transition-transform group-hover:-translate-x-1">←</span>
                <span class="text-[14px]">Todos los proyectos</span>
            </a>
            <a href="/BETA/satelock/" class="group inline-flex items-center gap-3 text-[#64748b] transition-colors hover:text-[#0f172a]">
                <span class="text-[14px]">Siguiente: <span class="font-semibold text-[#0f172a]">Satelock</span></span>
                <span class="transition-transform group-hover:translate-x-1">→</span>
            </a>
        </div>
    </section>
</BaseLayout>
