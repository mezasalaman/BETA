---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title,
  description,
  ogImage = 'https://mezasalaman.github.io/BETA/Media/Home/end.svg',
  ogType = 'website',
} = Astro.props;

// Absolute canonical URL (respects `site` + `base` from astro.config)
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="https://mezasalaman.github.io/BETA/Media/Home/icono%20meza.svg" type="image/svg+xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Tailwind via CDN + configuración y estilos compartidos -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline src={`${base}/assets/tw-config.js`}></script>
    <link rel="stylesheet" href={`${base}/assets/portfolio.css`} />
</head>

<body class="bg-ink font-sans text-[#0f172a] antialiased">
    <Nav />
    <slot />
    <Footer />
    <script is:inline src={`${base}/assets/site.js`}></script>
</body>

</html>
